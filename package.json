{
  "name": "studio-app",
  "private": true,
  "version": "0.0.0",
  "license": "MIT",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "test": "bun test ./src ./server",
    "build": "vite build",
    "equilibrium:export": "bun run scripts/export-equilibrium.ts",
    "equilibrium:server": "bun run server/equilibrium/serve.ts",
    "equilibrium:rehearse": "bun run server/equilibrium/rehearse.ts",
    "equilibrium:probe": "bun run scripts/equilibrium-probe.ts",
    "equilibrium:bytecode": "bun run scripts/equilibrium-bytecode.ts",
    "equilibrium:bytecode-build": "bash scripts/equilibrium-build-bytecode.sh",
    "equilibrium:fork-test": "EQUILIBRIUM_FORK=1 bun test server/equilibrium/evm/__tests__/fork.test.ts",
    "equilibrium:fork-up": "bun run server/equilibrium/evm/fork-up.ts",
    "equilibrium:evm-serve": "bun run server/equilibrium/evm/serve.ts",
    "equilibrium:evm-launch": "bun run scripts/equilibrium-evm-launch.ts",
    "equilibrium:infra": "bun run scripts/equilibrium-infra.ts",
    "equilibrium:keeper": "bun run server/equilibrium/keeper/cli.ts",
    "equilibrium:keeper-bytecode": "bun run scripts/equilibrium-keeper-bytecode.ts",
    "equilibrium:keeper-rehearse": "bun run server/equilibrium/keeper/rehearse.ts",
    "equilibrium:keeper-fork-test": "EQUILIBRIUM_FORK=1 bun test server/equilibrium/keeper/__tests__/fork.test.ts",
    "equilibrium:keeper-maintenance-fork-test": "EQUILIBRIUM_FORK=1 bun test server/equilibrium/keeper/__tests__/maintenance.fork.test.ts",
    "equilibrium:keeper-maintenance-rehearse": "bun run server/equilibrium/keeper/maintenance-rehearse.ts",
    "equilibrium:keeper-token-refill-rehearse": "bun run server/equilibrium/keeper/token-refill-rehearse.ts",
    "equilibrium:keeper-token-refill-fork-test": "EQUILIBRIUM_FORK=1 bun test server/equilibrium/keeper/__tests__/token-refill.fork.test.ts",
    "equilibrium:gate-challenge": "bun run server/equilibrium/evm/challenge.ts",
    "equilibrium:transfer": "bun run server/equilibrium/evm/transfers/cli.ts",
    "equilibrium:transfers-fork-test": "EQUILIBRIUM_FORK=1 bun test server/equilibrium/evm/transfers/__tests__/returns.fork.test.ts server/equilibrium/evm/transfers/__tests__/refill.fork.test.ts",
    "equilibrium:transfers-rehearse": "bun run server/equilibrium/evm/transfers/rehearse.ts",
    "equilibrium:transfer-bytecode": "bun run scripts/equilibrium-transfer-bytecode.ts",
    "equilibrium:refill-verify": "bun run scripts/equilibrium-refill-verify.ts",
    "equilibrium:contracts": "FOUNDRY_PROFILE=equilibrium forge test -vv",
    "deploy:self": "bun run ./scripts/self-deploy.ts",
    "compass:deploy": "bun run ./scripts/compass-deploy.ts",
    "fetch:abi": "bun run ./scripts/fetch-abi.ts",
    "lint": "oxlint --type-aware src scripts && oxlint --type-aware server/equilibrium && oxlint .",
    "typecheck": "tsc --noEmit && tsc --noEmit -p server/equilibrium/tsconfig.json",
    "check": "bash scripts/check.sh",
    "contracts:build": "forge build",
    "contracts:test": "forge test",
    "contracts:solhint": "solhint 'contracts/**/*.sol' --ignore-path .solhintignore",
    "contracts:slither": "slither .",
    "contracts:aderyn": "aderyn . -o reports/security/aderyn-report.md",
    "contracts:mythril": "bash scripts/security/run-mythril.sh",
    "contracts:echidna": "bash scripts/security/run-echidna.sh",
    "contracts:security": "bun run contracts:solhint && bun run contracts:slither && bun run contracts:aderyn"
  },
  "dependencies": {
    "@circle-fin/adapter-solana": "^1.7.3",
    "@circle-fin/adapter-viem-v2": "^1.18.0",
    "@circle-fin/app-kit": "^1.15.1",
    "@circle-fin/developer-controlled-wallets": "^10.8.0",
    "@circle-fin/modular-wallets-core": "^1.0.16",
    "@circle-fin/smart-contract-platform": "^10.8.0",
    "@circle-fin/user-controlled-wallets": "^10.8.0",
    "@circle-fin/w3s-pw-web-sdk": "^1.1.11",
    "@fontsource-variable/public-sans": "^5.3.0",
    "@openzeppelin/contracts": "5.1.0",
    "@tanstack/react-query": "^5.62.7",
    "@uniswap/sdk-core": "^7.19.3",
    "@uniswap/v3-sdk": "^3.31.4",
    "@uniswap/v4-sdk": "^2.4.0",
    "@vercel/analytics": "^2.0.1",
    "@vercel/speed-insights": "^2.0.0",
    "@web3icons/react": "^4.0.0",
    "@x402/core": "2.26.0",
    "canvas-confetti": "^1.9.4",
    "clsx": "^2.1.1",
    "connectkit": "^1.9.2",
    "framer-motion": "^11.15.0",
    "lucide-react": "^0.468.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "sonner": "^1.7.1",
    "tailwind-merge": "^2.6.0",
    "viem": "^2.56.3",
    "wagmi": "^2.19.5"
  },
  "overrides": {
    "viem": "^2.56.3"
  },
  "devDependencies": {
    "@types/bun": "1.4.2",
    "@types/canvas-confetti": "^1.9.0",
    "@types/node": "^24.0.0",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@uniswap/v4-core": "1.0.2",
    "@uniswap/v4-periphery": "1.0.3",
    "@vitejs/plugin-react": "^4.3.4",
    "autoprefixer": "^10.4.20",
    "oxlint": "^1.80.0",
    "oxlint-tsgolint": "^7.0.2001",
    "postcss": "^8.4.49",
    "solhint": "^6.2.4",
    "tailwindcss": "^3.4.17",
    "typescript": "~7.0.2",
    "vite": "^6.0.5",
    "vite-plugin-node-polyfills": "^0.22.0"
  }
}
